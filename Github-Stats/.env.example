# GitHub Personal Access Token (classic with 'repo' and 'read:user' scope, or fine-grained token)
# Required for querying GraphQL API and private contribution streaks
GITHUB_TOKEN=your_github_token_here

# Optional: Multiple tokens for load balancing in high-traffic hosted API mode
# GITHUB_TOKENS=token1,token2,token3

# Default timezone for streak calculations (e.g., Asia/Kolkata, America/New_York, UTC)
TIMEZONE=Asia/Kolkata

# Server Port
PORT=3000
